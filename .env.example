# Copy to .env and fill in. Never commit .env.
# Provider: groq | openai | openrouter | ollama | custom | mock
AGENT_PROVIDER=groq
# Optional model override (otherwise the provider default is used)
# AGENT_MODEL=openai/gpt-oss-120b

# One key per provider (only the one you use is needed)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Ollama needs no key (local): AGENT_PROVIDER=ollama

# custom = any OpenAI-compatible endpoint
# AGENT_BASE_URL=http://localhost:8000/v1
# AGENT_API_KEY=

# GitHub tools (optional). Otherwise the `gh` CLI login is used if present.
# GITHUB_TOKEN=

# Web search endpoint (optional, default: DuckDuckGo HTML, best-effort)
# AGENT_SEARCH_URL=https://html.duckduckgo.com/html/
